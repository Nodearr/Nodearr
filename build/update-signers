# Who may sign Nodearr's update manifests, for ssh-keygen -Y verify (ADR 0024). The same key is
# built into Nodearr, in src/NzbDrone.Core/Update/UpdateSigningKey.cs.
#
#   ssh-keygen -Y verify -f build/update-signers -I nodearr-release -n nodearr-update -s main.json.sig < main.json
nodearr-release namespaces="nodearr-update" ssh-rsa 
